generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("marketer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                  String             @id @default(cuid())
  name                String
  phone               String
  email               String             @unique
  businessName        String
  businessType        String
  source              String
  serviceInterestedIn String
  status              LeadStatus         @default(NEW_LEAD)
  dealValue           Decimal            @db.Decimal(12, 2)
  estimatedDealValue  Decimal?           @db.Decimal(12, 2)
  birthday            DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastContactedAt     DateTime?
  nextFollowUpDate    DateTime?
  nextFollowUpAt      DateTime?
  campaigns           EmailCampaign[]
  followUps           FollowUp[]
  activities          FollowUpActivity[]
  quotes              Quote[]
  assets              LeadAsset[]
  payments            Payment[]
  productionJobs      ProductionJob[]
  proofAssets         ProofAsset[]
  contentPosts        ContentPost[]
  communications      Communication[]
}

model ContentBrief {
  id        String   @id @default(cuid())
  platform  String
  offer     String
  audience  String
  service   String
  tone      String
  cta       String
  painPoint String
  outputs   Json
  createdAt DateTime @default(now())
}

model EmailCampaign {
  id          String         @id @default(cuid())
  title       String
  template    String
  audience    String
  subject     String
  body        String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  enabled     Boolean  @default(false)
  trigger     String
  channel     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  dueDate     DateTime
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Quote {
  id              String          @id @default(cuid())
  leadId          String
  quoteNumber     String          @unique
  businessName    String
  clientName      String
  serviceCategory String
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @default(0) @db.Decimal(12, 2)
  finalTotal      Decimal         @default(0) @db.Decimal(12, 2)
  status          QuoteStatus     @default(DRAFT)
  notes           String?
  terms           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  expiryDate      DateTime
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lineItems       QuoteLineItem[]
  payments        Payment[]
  productionJob   ProductionJob?
  proofAssets     ProofAsset[]
  contentPosts    ContentPost[]
  communications  Communication[]
}

model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  quoteId   String
  leadId    String?
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime
  createdAt DateTime      @default(now())
  quote     Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
}
model ProductionJob {
  id               String             @id @default(cuid())
  quoteId          String             @unique
  leadId           String
  title            String
  status           ProductionStatus   @default(READY_TO_START)
  priority         ProductionPriority @default(NORMAL)
  dueDate          DateTime?
  installationDate DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  quote            Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lead             Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proofAssets      ProofAsset[]
  contentPosts     ContentPost[]
  communications   Communication[]
}
model ProofAsset {
  id              String           @id @default(cuid())
  leadId          String
  quoteId         String?
  productionJobId String?
  type            ProofAssetType
  title           String
  content         String?
  url             String?
  status          ProofStatus      @default(TODO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  productionJob   ProductionJob?   @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  contentPosts    ContentPost[]
  communications  Communication[]
}
model ContentPost {
  id              String          @id @default(cuid())
  proofAssetId    String?
  leadId          String?
  quoteId         String?
  productionJobId String?
  title           String
  platform        ContentPlatform @default(FACEBOOK)
  format          ContentFormat   @default(COMPLETED_PROJECT)
  status          ContentStatus   @default(IDEA)
  caption         String
  mediaUrl        String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  proofAsset      ProofAsset?     @relation(fields: [proofAssetId], references: [id], onDelete: SetNull)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote           Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  productionJob   ProductionJob?  @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  communications  Communication[]
}
model Communication {
  id              String                 @id @default(cuid())
  leadId          String?
  quoteId         String?
  productionJobId String?
  proofAssetId    String?
  contentPostId   String?
  channel         CommunicationChannel
  direction       CommunicationDirection @default(OUTBOUND)
  status          CommunicationStatus    @default(DRAFT)
  trigger         CommunicationTrigger   @default(CUSTOM)
  subject         String?
  body            String
  recipientName   String?
  recipientEmail  String?
  recipientPhone  String?
  scheduledFor    DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  error           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lead            Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote           Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  productionJob   ProductionJob?         @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  proofAsset      ProofAsset?            @relation(fields: [proofAssetId], references: [id], onDelete: SetNull)
  contentPost     ContentPost?           @relation(fields: [contentPostId], references: [id], onDelete: SetNull)
}
model FollowUpActivity {
  id          String               @id @default(cuid())
  leadId      String
  type        FollowUpActivityType
  title       String
  note        String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime             @default(now())
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUOTE_REQUESTED
  QUOTE_SENT
  FOLLOW_UP_NEEDED
  NEGOTIATING
  WON
  LOST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  FOLLOW_UP_DUE
  ACCEPTED
  REJECTED
  PAID
}

enum FollowUpActivityType {
  CALL
  WHATSAPP
  EMAIL
  STAGE_CHANGE
  QUOTE_CREATED
  NOTE
}

enum ProductionStatus {
  READY_TO_START
  DESIGN_ARTWORK
  PRINTING_FABRICATION
  INSTALLATION_SCHEDULED
  INSTALLED_DELIVERED
  AWAITING_BALANCE
  COMPLETED
  REVIEW_REQUESTED
  CANCELLED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum ProofAssetType {
  REVIEW_REQUEST
  TESTIMONIAL
  BEFORE_AFTER
  CASE_STUDY
  REFERRAL_REQUEST
  SOCIAL_POST
  OTHER
}

enum ProofStatus {
  TODO
  REQUESTED
  RECEIVED
  DRAFTED
  PUBLISHED
  ARCHIVED
}
enum ContentPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP_STATUS
  LINKEDIN
  TIKTOK
  WEBSITE
  OTHER
}

enum ContentFormat {
  BEFORE_AFTER
  TESTIMONIAL
  CASE_STUDY
  COMPLETED_PROJECT
  OFFER
  EDUCATIONAL
  OTHER
}

enum ContentStatus {
  IDEA
  DRAFTED
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}
enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  INTERNAL_NOTE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationStatus {
  DRAFT
  READY
  SENT
  FAILED
  SKIPPED
  SCHEDULED
}

enum CommunicationTrigger {
  NEW_LEAD
  ASSETS_RECEIVED
  MISSING_ASSETS
  MOCKUP_IN_DESIGN
  MOCKUP_SENT
  QUOTE_CREATED
  QUOTE_SENT
  DEPOSIT_REMINDER
  PAYMENT_RECEIVED
  PRODUCTION_STARTED
  INSTALLATION_SCHEDULED
  BALANCE_REMINDER
  JOB_COMPLETED
  REVIEW_REQUEST
  REFERRAL_REQUEST
  CONTENT_PERMISSION
  CUSTOM
}
enum PaymentMethod {
  CASH
  ECOCASH
  BANK_TRANSFER
  SWIPE
  USD_CASH
  OTHER
}
enum LeadAssetType {
  SHOPFRONT_IMAGE
  LOGO
  REFERENCE_IMAGE
  OTHER
}
model LeadAsset {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadAssetType
  url         String
  pathname    String
  filename    String
  contentType String
  size        Int
  notes       String?
  createdAt   DateTime      @default(now())
}





