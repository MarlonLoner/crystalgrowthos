generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUOTE_REQUESTED
  QUOTE_SENT
  FOLLOW_UP_NEEDED
  NEGOTIATING
  WON
  LOST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  FOLLOW_UP_DUE
  ACCEPTED
  REJECTED
  PAID
}

enum FollowUpActivityType {
  CALL
  WHATSAPP
  EMAIL
  STAGE_CHANGE
  QUOTE_CREATED
  NOTE
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("marketer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                  String     @id @default(cuid())
  name                String
  phone               String
  email               String     @unique
  businessName        String
  businessType        String
  source              String
  serviceInterestedIn String
  status              LeadStatus @default(NEW_LEAD)
  dealValue           Decimal    @db.Decimal(12, 2)
  estimatedDealValue  Decimal?   @db.Decimal(12, 2)
  birthday            DateTime?
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastContactedAt     DateTime?
  nextFollowUpDate    DateTime?
  nextFollowUpAt      DateTime?
  campaigns           EmailCampaign[]
  followUps           FollowUp[]
  quotes              Quote[]
  activities          FollowUpActivity[]
}

model ContentBrief {
  id        String   @id @default(cuid())
  platform  String
  offer     String
  audience  String
  service   String
  tone      String
  cta       String
  painPoint String
  outputs   Json
  createdAt DateTime @default(now())
}

model EmailCampaign {
  id          String         @id @default(cuid())
  title       String
  template    String
  audience    String
  subject     String
  body        String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  enabled     Boolean  @default(false)
  trigger     String
  channel     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model FollowUp {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  completedAt DateTime?
  note        String?
  createdAt   DateTime @default(now())
}

model Quote {
  id              String          @id @default(cuid())
  leadId          String
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteNumber     String          @unique
  businessName    String
  clientName      String
  serviceCategory String
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @default(0) @db.Decimal(12, 2)
  finalTotal      Decimal         @default(0) @db.Decimal(12, 2)
  status          QuoteStatus     @default(DRAFT)
  notes           String?
  terms           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  expiryDate      DateTime
  lineItems       QuoteLineItem[]
}

model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model FollowUpActivity {
  id          String               @id @default(cuid())
  leadId      String
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        FollowUpActivityType
  title       String
  note        String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime             @default(now())
}
