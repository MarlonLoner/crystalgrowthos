# Required for Prisma/PostgreSQL. Use Neon, Supabase, or another hosted Postgres database in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Reserved for the MVP auth surface and future NextAuth/Credentials implementation.
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: mock AI outputs work without this. Set it when the OpenAI integration is connected.
OPENAI_API_KEY=""

# Required for Vercel Blob asset uploads on shopfront mockup requests.
BLOB_READ_WRITE_TOKEN="vercel-blob-read-write-token"
