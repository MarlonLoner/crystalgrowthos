# Required for Prisma/PostgreSQL. Use Neon, Supabase, or another hosted Postgres database in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Required for the simple MVP admin gate. Use strong unique values in local and Vercel environments.
ADMIN_PASSWORD="replace-with-secure-admin-password"
AUTH_SECRET="replace-with-secure-random-secret"

# Reserved for a future NextAuth/Credentials implementation if the auth layer is upgraded later.
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: mock AI outputs work without this. Set it when the OpenAI integration is connected.
OPENAI_API_KEY=""

# Required for Vercel Blob asset uploads on shopfront mockup requests.
BLOB_READ_WRITE_TOKEN="vercel-blob-read-write-token"


# Email sending through Resend. Keep EMAIL_TEST_MODE=true until you confirm delivery safely.
RESEND_API_KEY=""
EMAIL_FROM="Crystal Branding Studio <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=""
EMAIL_TEST_MODE="true"
EMAIL_TEST_RECIPIENT=""

# Scheduled email automation. Keep disabled until test emails are confirmed safely.
CRON_SECRET="replace-with-secure-cron-secret"
AUTO_EMAIL_ENABLED="false"

